# Local dataset root. Artifacts must store paths relative to this directory.
AIC_DATA=D:\path\to\aic-data

# System FFmpeg executables. Use absolute paths only in local environment config when the
# commands are not available in PATH; never serialize these paths into dataset artifacts.
AIC_FFMPEG=ffmpeg
AIC_FFPROBE=ffprobe

# Optional TransNetV2 weight override. The pinned package already contains a bundled weight
# whose SHA-256 is verified by the pipeline. If overriding it, both values are mandatory.
# AIC_TRANSNETV2_WEIGHTS=D:\path\to\models\transnetv2-pytorch-weights.pth
# AIC_TRANSNETV2_WEIGHTS_SHA256=replace_with_verified_sha256

# Shot Detection defaults to CPU. Use cuda only after CPU/CUDA manifest parity passes.
AIC_TRANSNETV2_DEVICE=cpu

# Optional Hugging Face cache location. Do not commit tokens or credentials.
HF_HOME=D:\path\to\hf-cache
